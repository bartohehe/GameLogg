# Komentarze trzymaj w osobnych liniach: Docker Compose przy pustej wartości
# wczytuje komentarz z tej samej linii jako wartość zmiennej.

DATABASE_URL=postgres://gamelogg:change-me@postgres:5432/gamelogg?sslmode=disable
POSTGRES_PASSWORD=change-me

# Min. 32 znaki. Start bez niego = błąd, gdy AUTH_ENABLED=true.
# Wygeneruj np. przez: openssl rand -hex 32
JWT_SECRET=

IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Opcjonalny: bez niego wyszukiwanie filmów/seriali jest wyłączone, anime (Jikan) działa.
TMDB_API_KEY=

AUTH_ENABLED=true
MEDIA_ENABLED=true
TRANSLATION_ENABLED=true
PORT=8080

# production (logi JSON) albo dev (czytelne logi tekstowe z poziomem debug)
APP_ENV=production
